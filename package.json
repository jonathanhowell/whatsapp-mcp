{
  "name": "whatsapp-mcp",
  "version": "1.1.0",
  "description": "Read-only MCP server for WhatsApp Desktop messages (macOS only)",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "claude",
    "macos",
    "sqlite"
  ],
  "author": "Jonathan Howell",
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.8.0",
    "smol-toml": "1.6.1",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
